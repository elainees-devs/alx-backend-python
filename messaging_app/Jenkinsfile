pipeline {
    agent {
        docker {
            image 'python:3.10'
            args '-u root:root' // run as root to avoid permission issues
        }
    }

    environment {
        VENV_DIR = "${WORKSPACE}/venv"
    }

    options {
        skipDefaultCheckout()
    }

    stages {

        stage('Clean Workspace') {
            steps {
                deleteDir()
            }
        }

        stage('Install Git') {
            steps {
                sh 'apt-get update && apt-get install -y git'
            }
        }

        stage('Checkout Code') {
            steps {
                checkout([$class: 'GitSCM', 
                    branches: [[name: 'main']], 
                    userRemoteConfigs: [[
                        url: 'https://github.com/elainees-devs/alx-backend-python.git',
                        credentialsId: 'github-creds'
                    ]]
                ])
            }
        }

        stage('Validate Jenkinsfile') {
            steps {
                script {
                    if (!fileExists('messaging_app/Jenkinsfile')) {
                        error("❌ messaging_app/Jenkinsfile does not exist!")
                    }
                    def jfContent = readFile('messaging_app/Jenkinsfile').trim()
                    if (jfContent.isEmpty()) {
                        error("❌ messaging_app/Jenkinsfile is empty!")
                    }
                    echo "✅ messaging_app/Jenkinsfile exists and is not empty."
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                    python -m venv $VENV_DIR
                    . $VENV_DIR/bin/activate
                    pip install --upgrade pip
                    pip install -r messaging_app/requirements.txt
                '''
            }
        }

        stage('Run Tests') {
            steps {
                sh '''
                    . $VENV_DIR/bin/activate
                    pytest --junitxml=test-results.xml || exit 1
                '''
            }
            post {
                always {
                    junit 'test-results.xml'
                }
            }
        }
    }

    post {
        always {
            echo "Pipeline finished. Check test results and reports."
        }
    }
}
