pipeline {
    agent {
        docker {
            image 'python:3.10'
            args '-u root:root' // run as root
        }
    }

    environment {
        VENV_DIR = "${WORKSPACE}/venv"
        GIT_CREDENTIALS = 'github-creds'
        REPO_URL = 'https://github.com/elainees-devs/alx-backend-python.git'
        BRANCH_NAME = 'main'

        // Docker Hub credentials
        DOCKER_CREDENTIALS = 'dockerhub-creds' // Jenkins credentials ID
        DOCKER_IMAGE = 'yourdockerhubusername/messaging_app:latest'
    }

    options {
        skipDefaultCheckout()
    }

    stages {
        stage('Prepare Container') {
            steps {
                sh '''
                    apt-get update
                    apt-get install -y git python3-venv gcc docker.io
                '''
            }
        }

        stage('Checkout Code') {
            steps {
                withCredentials([usernamePassword(credentialsId: env.GIT_CREDENTIALS,
                                                  usernameVariable: 'GIT_USER',
                                                  passwordVariable: 'GIT_PASS')]) {
                    sh '''
                        rm -rf messaging_app
                        git clone https://${GIT_USER}:${GIT_PASS}@${REPO_URL#https://} messaging_app
                        cd messaging_app
                        git branch ${BRANCH_NAME} origin/${BRANCH_NAME}
                        git checkout ${BRANCH_NAME}
                    '''
                }
            }
        }

        stage('Validate Jenkinsfile and Requirements') {
            steps {
                script {
                    if (!fileExists('messaging_app/Jenkinsfile')) {
                        error("❌ Jenkinsfile missing")
                    }
                    if (!fileExists('messaging_app/requirements.txt')) {
                        error("❌ requirements.txt missing")
                    }
                    echo "✅ Validation passed"
                }
            }
        }

        stage('Setup Python & Run Tests') {
            steps {
                sh '''
                    rm -rf $VENV_DIR
                    python3 -m venv $VENV_DIR
                    . $VENV_DIR/bin/activate
                    pip3 install --upgrade pip
                    pip3 install -r messaging_app/requirements.txt
                    pytest --junitxml=test-results.xml || exit 1
                '''
            }
            post {
                always {
                    junit 'test-results.xml'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    cd messaging_app
                    docker build -t $DOCKER_IMAGE .
                '''
            }
        }

        stage('Push Docker Image') {
            steps {
                withCredentials([usernamePassword(credentialsId: env.DOCKER_CREDENTIALS,
                                                  usernameVariable: 'DOCKER_USER',
                                                  passwordVariable: 'DOCKER_PASS')]) {
                    sh '''
                        echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin
                        docker push $DOCKER_IMAGE
                    '''
                }
            }
        }
    }

    post {
        always {
            echo "Pipeline finished. Check tests and Docker image build/push."
        }
    }
}
