#!/bin/bash
# This script scales the Django app using Kubernetes.

# Step 1: Scale the Django app to 3 replicas
kubectl scale deployment django-messaging-app --replicas=3

# Step 2: Verify the pod status
echo "=== Pods after scaling ==="
kubectl get pods -l app=django-messaging-app

# Step 3: Perform load testing using wrk (replace <service-url> with actual service endpoint)
# Example: http://127.0.0.1:8000
echo "=== Load testing with wrk ==="
wrk -t2 -c100 -d30s http://127.0.0.1:8000

# Step 4: Monitor resource usage
echo "=== Resource usage ==="
kubectl top pods -l app=django-messaging-app
